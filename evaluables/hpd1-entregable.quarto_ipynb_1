        "            res = buscar(collection_c, q, k=k)\n",
        "            retrieved = res[\"ids\"][0]\n",
        "            r = recall_at_k(retrieved, relevantes, k)\n",
        "            recalls.append(r)\n",
        "        eval2_recall[f\"recall@{k}\"] = round(np.mean(recalls), 4)\n",
        "\n",
