        "#| echo: true\n",
        "\n",
        "if CAMINO == \"C\":\n",
        "    tools_definition_c = [\n",
        "        {\n",
        "            \"type\": \"function\",\n",
        "            \"function\": {\n",
        "                \"name\": \"listar_tablas\",\n",
        "                \"description\": \"Devuelve la lista de tablas disponibles en la base de datos de e-commerce.\",\n",
        "                \"parameters\": {\"type\": \"object\", \"properties\": {}, \"required\": []}\n",
        "            }\n",
        "        },\n",
        "        {\n",
        "            \"type\": \"function\",\n",
        "            \"function\": {\n",
        "                \"name\": \"describir_tabla\",\n",
        "                \"description\": \"Devuelve el DDL de una tabla específica.\",\n",
        "                \"parameters\": {\n",
        "                    \"type\": \"object\",\n",
        "                    \"properties\": {\"tabla\": {\"type\": \"string\", \"description\": \"Nombre de la tabla\"}},\n",
        "                    \"required\": [\"tabla\"]\n",
        "                }\n",
        "            }\n",
        "        },\n",
        "        {\n",
        "            \"type\": \"function\",\n",
        "            \"function\": {\n",
        "                \"name\": \"consultar_sql\",\n",
        "                \"description\": \"Ejecuta una consulta SQL SELECT. Tablas: productos(id, nombre, categoria, precio, stock, valoracion, proveedor), pedidos(id, producto_id, cliente_id, cantidad, fecha, estado, total), clientes(id, nombre, email, pais, fecha_registro, total_compras).\",\n",
        "                \"parameters\": {\n",
        "                    \"type\": \"object\",\n",
        "                    \"properties\": {\"query\": {\"type\": \"string\", \"description\": \"Consulta SQL SELECT\"}},\n",
        "                    \"required\": [\"query\"]\n",
        "                }\n",
        "            }\n",
        "        },\n",
        "    ]\n",
        "\n",
        "    def preguntar_al_llm(pregunta, tools_def, system_prompt=None):\n",
        "        if not client:\n",
        "            return \"⚠️  Cliente OpenAI no disponible.\"\n",
        "\n",
        "        if system_prompt is None:\n",
        "            system_prompt = \"Eres un asistente de e-commerce. Tienes acceso a una base de datos con productos, pedidos y clientes. Usa las herramientas disponibles para responder preguntas. Responde en español, de forma concisa.\"\n",
        "\n",
        "        messages = [\n",
        "            {\"role\": \"system\", \"content\": system_prompt},\n",
        "            {\"role\": \"user\", \"content\": pregunta}\n",
        "        ]\n",
        "\n",
        "        response = client.chat.completions.create(\n",
        "            model=\"gemma4:e2b-mlx\",\n",
        "            messages=messages,\n",
        "            tools=tools_def,\n",
        "            tool_choice=\"auto\",\n",
        "            max_tokens=1024,\n",
        "        )\n",
        "\n",
        "        message = response.choices[0].message\n",
        "\n",
        "        if message.tool_calls:\n",
        "            messages.append(message)\n",
        "            for tc in message.tool_calls:\n",
        "                args = json.loads(tc.function.arguments)\n",
        "                result = ejecutar_tool(tc.function.name, args)\n",
        "                messages.append({\n",
        "                    \"role\": \"tool\",\n",
        "                    \"tool_call_id\": tc.id,\n",
        "                    \"content\": result\n",
        "                })\n",
        "\n",
        "            final = client.chat.completions.create(\n",
        "                model=\"gemma4:e2b-mlx\",\n",
        "                messages=messages,\n",
        "                tools=tools_def,\n",
        "                tool_choice=\"none\",\n",
        "                max_tokens=512,\n",
        "            )\n",
        "            return final.choices[0].message.content\n",
        "        else:\n",
        "            return message.content\n",
        "\n",
        "    pregunta_c = \"¿Cuál es el producto más valorado con mejor stock y cuántos pedidos tiene?\"\n",
        "\n",
        "    if client:\n",
        "        respuesta_c = preguntar_al_llm(pregunta_c, tools_definition_c)\n",
        "        eval2_respuesta = f\"PREGUNTA: {pregunta_c}\\n\\nRESPUESTA: {respuesta_c}\"\n",
        "    else:\n",
        "        eval2_respuesta = \"⚠️  Cliente OpenAI no disponible. Pregunta: \" + pregunta_c\n",
        "\n",
        "    print(eval2_respuesta)\n",
        "else:\n",
        "    eval2_respuesta = None"
