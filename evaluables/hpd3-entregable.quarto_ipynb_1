        "### Ejercicio 1 — Servidor MCP (3 ptos) {#sec-hpd3-e1-c}\n",
        "\n",
        "Construye un servidor FastMCP que exponga las siguientes herramientas SQL sobre la base de datos de e-commerce:\n",
        "\n",
        "- `listar_tablas()` — devuelve la lista de tablas disponibles\n",
        "- `describir_tabla(tabla: str)` — devuelve el DDL de la tabla\n",
        "- `consultar_sql(query: str)` — ejecuta una consulta SELECT y devuelve resultados\n",
        "- Resource `resumen://tienda` — devuelve un resumen de la tienda (total productos, pedidos, clientes, ingresos totales, valoración media)\n",
        "\n",
        "Asigna el servidor a `eval1_server` (como string con los logs de creación y verificación)."
      ],
      "id": "0eff08a7"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "#| echo: true\n",
        "\n",
        "if CAMINO == \"C\":\n",
        "    from fastmcp import FastMCP\n",
        "\n",
        "    mcp_c = FastMCP(\"Servidor E-commerce MCP\")\n",
        "    TOOLS_MCP.clear()\n",
        "\n",
        "    @mcp_c.tool()\n",
        "    def listar_tablas() -> str:\n",
        "        \"\"\"Devuelve la lista de tablas disponibles en la base de datos de e-commerce.\"\"\"\n",
        "        cursor = db_c.execute(\"SELECT name FROM sqlite_master WHERE type='table' ORDER BY name\")\n",
        "        tablas = [row[0] for row in cursor.fetchall()]\n",
        "        return \"Tablas disponibles:\\n\" + \"\\n\".join(f\"  - {t}\" for t in tablas)\n",
        "\n",
        "    @mcp_c.tool()\n",
        "    def describir_tabla(tabla: str) -> str:\n",
        "        \"\"\"Devuelve el DDL (CREATE TABLE) de una tabla.\n",
        "\n",
        "        Args:\n",
        "            tabla: nombre de la tabla.\n",
        "        \"\"\"\n",
        "        tabla = tabla.strip().lower()\n",
        "        cursor = db_c.execute(\"SELECT sql FROM sqlite_master WHERE type='table' AND LOWER(name)=?\", (tabla,))\n",
        "        row = cursor.fetchone()\n",
        "        if row:\n",
        "            return row[0]\n",
        "        return f\"Error: tabla '{tabla}' no encontrada.\"\n",
        "\n",
        "    @mcp_c.tool()\n",
        "    def consultar_sql(query: str) -> str:\n",
        "        \"\"\"Ejecuta una consulta SQL SELECT en la base de datos de e-commerce.\n",
        "\n",
        "        Args:\n",
        "            query: consulta SQL (solo SELECT).\n",
        "        \"\"\"\n",
        "        query_stripped = query.strip().upper()\n",
        "        if not query_stripped.startswith(\"SELECT\"):\n",
        "            return \"Error: solo se permiten consultas SELECT.\"\n",
        "        palabras_prohibidas = [\"DROP\", \"DELETE\", \"UPDATE\", \"INSERT\", \"ALTER\", \"CREATE\", \"TRUNCATE\"]\n",
        "        for p in palabras_prohibidas:\n",
        "            if p in query_stripped:\n",
        "                return f\"Error: la consulta contiene '{p}' no permitido.\"\n",
        "        try:\n",
        "            cursor = db_c.execute(query)\n",
        "            columnas = [d[0] for d in cursor.description]\n",
        "            filas = cursor.fetchmany(30)\n",
        "            if not filas:\n",
        "                return \"No se encontraron resultados.\"\n",
        "            ancho = max(len(str(c)) for c in columnas)\n",
        "            lines = [\" | \".join(f\"{str(c):{ancho}}\" for c in columnas)]\n",
        "            lines.append(\"-\" * len(lines[0]))\n",
        "            for fila in filas:\n",
        "                lines.append(\" | \".join(f\"{str(v):{ancho}}\" for v in fila))\n",
        "            resultado = \"\\n\".join(lines)\n",
        "            if len(cursor.fetchall()) > 0:\n",
        "                resultado += f\"\\n... y más filas (mostrando primeras {len(filas)})\"\n",
        "            if len(resultado) > 2000:\n",
        "                resultado = resultado[:2000] + \"\\n... (resultado truncado a 2000 caracteres)\"\n",
        "            return resultado\n",
        "        except Exception as e:\n",
        "            return f\"Error ejecutando consulta: {e}\"\n",
        "\n",
        "    @mcp_c.resource(\"resumen://tienda\")\n",
        "    def resumen_tienda() -> str:\n",
        "        \"\"\"Resumen agregado de la tienda online.\"\"\"\n",
        "        total_prod = db_c.execute(\"SELECT COUNT(*) FROM productos\").fetchone()[0]\n",
        "        total_ped = db_c.execute(\"SELECT COUNT(*) FROM pedidos\").fetchone()[0]\n",
        "        total_clientes = db_c.execute(\"SELECT COUNT(*) FROM clientes\").fetchone()[0]\n",
        "        ingresos = db_c.execute(\"SELECT COALESCE(SUM(total), 0) FROM pedidos WHERE estado IN ('entregado', 'enviado')\").fetchone()[0]\n",
        "        valoracion_media = round(db_c.execute(\"SELECT AVG(valoracion) FROM productos\").fetchone()[0], 2)\n",
        "        stock_total = db_c.execute(\"SELECT SUM(stock) FROM productos\").fetchone()[0]\n",
        "        prod_bajo_stock = db_c.execute(\"SELECT COUNT(*) FROM productos WHERE stock < 100\").fetchone()[0]\n",
        "        pedidos_pendientes = db_c.execute(\"SELECT COUNT(*) FROM pedidos WHERE estado='pendiente'\").fetchone()[0]\n",
        "\n",
        "        lines = [\n",
        "            \"=== RESUMEN TIENDA ===\",\n",
        "            f\"Productos: {total_prod} (stock total: {stock_total})\",\n",
        "            f\"  - Productos con bajo stock: {prod_bajo_stock}\",\n",
        "            f\"Valoración media: {valoracion_media} / 5.0\",\n",
        "            f\"Pedidos totales: {total_ped}\",\n",
        "            f\"  - Pendientes: {pedidos_pendientes}\",\n",
        "            f\"Clientes registrados: {total_clientes}\",\n",
        "            f\"Ingresos totales: {ingresos:,.2f} EUR\",\n",
        "        ]\n",
        "        return \"\\n\".join(lines)\n",
        "\n",
        "    registrar_tool(\"listar_tablas\", listar_tablas)\n",
        "    registrar_tool(\"describir_tabla\", describir_tabla)\n",
        "    registrar_tool(\"consultar_sql\", consultar_sql)\n",
        "\n",
        "    eval1_server = \"✅ Servidor MCP E-commerce creado con 3 tools + 1 resource\\n\"\n",
        "    eval1_server += \"  Tools: listar_tablas, describir_tabla, consultar_sql\\n\"\n",
        "    eval1_server += \"  Resource: resumen://tienda\\n\"\n",
        "    eval1_server += \"\\n--- Prueba: listar_tablas ---\\n\"\n",
        "    eval1_server += listar_tablas()\n",
        "    eval1_server += \"\\n\\n--- Prueba: resource resumen://tienda ---\\n\"\n",
        "    eval1_server += resumen_tienda()\n",
        "    print(eval1_server)\n",
        "else:\n",
        "    eval1_server = None"
      ],
