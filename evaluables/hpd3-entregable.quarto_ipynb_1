        "#| echo: true\n",
        "\n",
        "if CAMINO == \"B\":\n",
        "    from fastmcp import FastMCP\n",
        "\n",
        "    mcp_b = FastMCP(\"Servidor Clínico MCP\")\n",
        "    TOOLS_MCP.clear()\n",
        "\n",
        "    @mcp_b.tool()\n",
        "    def listar_tablas() -> str:\n",
        "        \"\"\"Devuelve la lista de tablas disponibles en la base de datos clínica.\"\"\"\n",
        "        cursor = db_b.execute(\"SELECT name FROM sqlite_master WHERE type='table' ORDER BY name\")\n",
        "        tablas = [row[0] for row in cursor.fetchall()]\n",
        "        return \"Tablas disponibles:\\n\" + \"\\n\".join(f\"  - {t}\" for t in tablas)\n",
        "\n",
        "    @mcp_b.tool()\n",
        "    def describir_tabla(tabla: str) -> str:\n",
        "        \"\"\"Devuelve el DDL (CREATE TABLE) de una tabla.\n",
        "\n",
        "        Args:\n",
        "            tabla: nombre de la tabla.\n",
        "        \"\"\"\n",
        "        tabla = tabla.strip().lower()\n",
        "        cursor = db_b.execute(\"SELECT sql FROM sqlite_master WHERE type='table' AND LOWER(name)=?\", (tabla,))\n",
        "        row = cursor.fetchone()\n",
        "        if row:\n",
        "            return row[0]\n",
        "        return f\"Error: tabla '{tabla}' no encontrada.\"\n",
        "\n",
        "    @mcp_b.tool()\n",
        "    def consultar_sql(query: str) -> str:\n",
        "        \"\"\"Ejecuta una consulta SQL SELECT en la base de datos clínica.\n",
        "\n",
        "        Args:\n",
        "            query: consulta SQL (solo SELECT).\n",
        "        \"\"\"\n",
        "        query_stripped = query.strip().upper()\n",
        "        if not query_stripped.startswith(\"SELECT\"):\n",
        "            return \"Error: solo se permiten consultas SELECT.\"\n",
        "        palabras_prohibidas = [\"DROP\", \"DELETE\", \"UPDATE\", \"INSERT\", \"ALTER\", \"CREATE\", \"TRUNCATE\"]\n",
        "        for p in palabras_prohibidas:\n",
        "            if p in query_stripped:\n",
        "                return f\"Error: la consulta contiene '{p}' no permitido.\"\n",
        "        try:\n",
        "            cursor = db_b.execute(query)\n",
        "            columnas = [d[0] for d in cursor.description]\n",
        "            filas = cursor.fetchmany(30)\n",
        "            if not filas:\n",
        "                return \"No se encontraron resultados.\"\n",
        "            ancho = max(len(str(c)) for c in columnas)\n",
        "            lines = [\" | \".join(f\"{str(c):{ancho}}\" for c in columnas)]\n",
        "            lines.append(\"-\" * len(lines[0]))\n",
        "            for fila in filas:\n",
        "                lines.append(\" | \".join(f\"{str(v):{ancho}}\" for v in fila))\n",
        "            resultado = \"\\n\".join(lines)\n",
        "            if len(cursor.fetchall()) > 0:\n",
        "                resultado += f\"\\n... y más filas (mostrando primeras {len(filas)})\"\n",
        "            if len(resultado) > 2000:\n",
        "                resultado = resultado[:2000] + \"\\n... (resultado truncado a 2000 caracteres)\"\n",
        "            return resultado\n",
        "        except Exception as e:\n",
        "            return f\"Error ejecutando consulta: {e}\"\n",
        "\n",
        "    @mcp_b.resource(\"resumen://clinica\")\n",
        "    def resumen_clinico() -> str:\n",
        "        \"\"\"Resumen agregado de la base de datos clínica.\"\"\"\n",
        "        total_pac = db_b.execute(\"SELECT COUNT(*) FROM pacientes\").fetchone()[0]\n",
        "        edad_media = db_b.execute(\"SELECT AVG(edad) FROM pacientes\").fetchone()[0]\n",
        "        diag_activos = db_b.execute(\"SELECT COUNT(*) FROM diagnosticos WHERE estado='activo'\").fetchone()[0]\n",
        "        diag_cronicos = db_b.execute(\"SELECT COUNT(*) FROM diagnosticos WHERE estado='cronico'\").fetchone()[0]\n",
        "        total_meds = db_b.execute(\"SELECT COUNT(*) FROM medicamentos\").fetchone()[0]\n",
        "        meds_activos = db_b.execute(\"SELECT COUNT(*) FROM medicamentos WHERE fecha_fin IS NULL\").fetchone()[0]\n",
        "\n",
        "        grupos = db_b.execute(\"SELECT grupo_sanguineo, COUNT(*) FROM pacientes GROUP BY grupo_sanguineo ORDER BY grupo_sanguineo\").fetchall()\n",
        "        grupo_str = \"\\n\".join(f\"  - {g}: {c} pacientes\" for g, c in grupos)\n",
        "\n",
        "        lines = [\n",
        "            \"=== RESUMEN CLÍNICO ===\",\n",
        "            f\"Pacientes totales: {total_pac}\",\n",
        "            f\"Edad media: {edad_media:.1f} años\",\n",
        "            f\"Diagnósticos activos: {diag_activos}\",\n",
        "            f\"Diagnósticos crónicos: {diag_cronicos}\",\n",
        "            f\"Medicamentos totales: {total_meds}\",\n",
        "            f\"Medicamentos activos: {meds_activos}\",\n",
        "            \"\",\n",
        "            \"Distribución grupo sanguíneo:\",\n",
        "            grupo_str,\n",
        "        ]\n",
        "        return \"\\n\".join(lines)\n",
        "\n",
        "    registrar_tool(\"listar_tablas\", listar_tablas)\n",
        "    registrar_tool(\"describir_tabla\", describir_tabla)\n",
        "    registrar_tool(\"consultar_sql\", consultar_sql)\n",
        "\n",
        "    eval1_server = \"✅ Servidor MCP Clínico creado con 3 tools + 1 resource\\n\"\n",
        "    eval1_server += \"  Tools: listar_tablas, describir_tabla, consultar_sql\\n\"\n",
