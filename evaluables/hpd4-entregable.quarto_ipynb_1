        "#| echo: true\n",
        "\n",
        "class PDF(FPDF):\n",
        "    pass\n",
        "\n",
        "def crear_pdf(nombre, titulo, contenido):\n",
        "    pdf = PDF()\n",
        "    pdf.add_page()\n",
        "    pdf.set_font(\"Helvetica\", \"B\", 16)\n",
        "    pdf.cell(0, 10, titulo.replace(\"—\", \"-\").replace(\"€\", \"EUR\"), new_x=\"LMARGIN\", new_y=\"NEXT\")\n",
        "    pdf.ln(5)\n",
        "    pdf.set_font(\"Helvetica\", \"\", 11)\n",
        "    pdf.multi_cell(0, 6, contenido.replace(\"—\", \"-\").replace(\"€\", \"EUR\"))\n",
        "    pdf.output(os.path.join(CORPUS_DIR, nombre))\n",
        "\n",
        "def cargar_y_trocear_pdfs(dir_path, chunk_size=CHUNK_SIZE, chunk_overlap=CHUNK_OVERLAP):\n",
        "    documentos = []\n",
        "    for filename in sorted(os.listdir(dir_path)):\n",
        "        if not filename.endswith(\".pdf\"):\n",
        "            continue\n",
        "        loader = PyPDFLoader(os.path.join(dir_path, filename))\n",
        "        documentos.extend(loader.load())\n",
        "    splitter = RecursiveCharacterTextSplitter(\n",
        "        chunk_size=chunk_size,\n",
        "        chunk_overlap=chunk_overlap,\n",
        "        separators=[\"\\n\\n\", \"\\n\", \". \", \" \", \"\"]\n",
        "    )\n",
        "    return splitter.split_documents(documentos)\n",
        "\n",
        "def indexar_chunks(collection, chunks, prefix=\"\"):\n",
        "    for i, chunk in enumerate(chunks):\n",
        "        embedding = model.encode(chunk.page_content).tolist()\n",
        "        fuente = os.path.basename(chunk.metadata.get(\"source\", \"\"))\n",
        "        cid = f\"{prefix}{i:04d}\"\n",
        "        collection.add(\n",
        "            ids=[cid],\n",
        "            embeddings=[embedding],\n",
        "            documents=[chunk.page_content],\n",
        "            metadatas=[{\"fuente\": fuente, \"idx\": i}]\n",
        "        )\n",
        "\n",
        "def indexar_textos(collection, textos, metadatas_list, prefix=\"\"):\n",
        "    for i, texto in enumerate(textos):\n",
        "        embedding = model.encode(texto).tolist()\n",
        "        cid = f\"{prefix}{i:04d}\"\n",
        "        meta = metadatas_list[i] if metadatas_list else {}\n",
        "        collection.add(\n",
        "            ids=[cid],\n",
        "            embeddings=[embedding],\n",
        "            documents=[texto],\n",
        "            metadatas=[meta]\n",
        "        )\n",
        "\n",
        "def buscar(collection, query, k=5):\n",
        "    qe = model.encode(query).tolist()\n",
        "    res = collection.query(query_embeddings=[qe], n_results=k)\n",
        "    resultados = []\n",
        "    if res[\"ids\"] and res[\"ids\"][0]:\n",
        "        for i in range(len(res[\"ids\"][0])):\n",
        "            resultados.append({\n",
        "                \"id\": res[\"ids\"][0][i],\n",
        "                \"texto\": res[\"documents\"][0][i],\n",
        "                \"distancia\": res[\"distances\"][0][i],\n",
        "                \"metadata\": res[\"metadatas\"][0][i] if res[\"metadatas\"] else {},\n",
        "            })\n",
        "    return resultados\n",
        "\n",
        "def rag(pregunta, collection_pdf, collection_sql, k_pdf=3, k_sql=3):\n",
        "    if not LLM_KEY:\n",
        "        return {\"respuesta\": \"⚠️ Configura LLM_API_KEY en .env\", \"fuentes\": [], \"pregunta\": pregunta}\n",
        "    resultados_pdf = buscar(collection_pdf, pregunta, k=k_pdf)\n",
        "    resultados_sql = buscar(collection_sql, pregunta, k=k_sql)\n",
        "    combinados = sorted(resultados_pdf + resultados_sql, key=lambda r: r[\"distancia\"])[:3]\n",
        "    contexto = \"\\n\\n\".join(r[\"texto\"] for r in combinados)\n",
        "    prompt = f\"\"\"Eres un analista de negocio que responde preguntas basándote EXCLUSIVAMENTE en los fragmentos proporcionados.\n",
        "\n",
        "Contexto:\n",
        "{contexto}\n",
        "\n",
        "Pregunta: {pregunta}\n",
        "\n",
        "Responde de forma concisa en español. Si el contexto no contiene información suficiente, di exactamente \"No tengo datos suficientes para responder a esta pregunta\" y no inventes nada.\"\"\"\n",
        "    respuesta = llm.invoke(prompt).content\n",
        "    return {\"respuesta\": respuesta, \"fuentes\": [r[\"texto\"] for r in combinados], \"pregunta\": pregunta}\n",
        "\n",
        "print(\"✅ Funciones auxiliares cargadas.\")"
      ],
