        "        continue\n",
        "    loader = PyPDFLoader(os.path.join(CORPUS_DIR, filename))\n",
        "    docs.extend(loader.load())\n",
        "\n",
        "print(f\"Corpus listo: {len(docs)} páginas cargadas en {CORPUS_DIR}\")"
