    "#| echo: true\n",
    "#| eval: true\n",
    "\n",
    "from rouge_score import rouge_scorer\n",
    "\n",
    "scorer = rouge_scorer.RougeScorer(['rougeL'], use_stemmer=True)\n",
    "\n",
    "referencia = \"El Transformer utiliza anteción multi-cabeza para modelar dependencias\"\n",
    "candidatos = [\n",
    "    \"El Transformer usa atención multi-cabeza para dependencias\", #buena\n",
    "    \"El modelo aplica self-attention con múltiples cabezas\", #paráfrasis\n",
    "    \"Las redes recurrentes procesan secuencias con LSTM\"\n",
    "]\n",
    "\n",
    "print(f\"Referencia: {referencia}\\n\")\n",
    "for c in candidatos:\n",
    "    scores = scorer.score(referencia, c)\n",
    "    #Obtenemos la métrica agregada F1-Score (fmeasure)\n",
    "    print(f\"   ROUGE-L = {scores['rougeL'].fmeasure:.3f} -> {c}\")"
   ]
