   "source": [
    "#| echo: true\n",
    "#| eval: false\n",
    "#| code-fold: true\n",
    "\n",
    "from transformers import AutoTokenizer, AutoModelForCausalLM\n",
    "import torch\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "MODEL = \"distilgpt2\"\n",
    "tokenizer = AutoTokenizer.from_pretrained(MODEL)\n",
    "model = AutoModelForCausalLM.from_pretrained(MODEL)\n",
    "model.eval()\n",
    "\n",
    "prompt = \"The future of artificial intelligence is\"\n",
    "inputs = tokenizer(prompt, return_tensors=\"pt\")\n",
    "with torch.no_grad():\n",
    "    logits = model(**inputs).logits[0, -1, :]\n",
    "\n",
    "top_logits, top_ids = torch.topk(logits, 10)\n",
    "tokens = [tokenizer.decode([i]) for i in top_ids]\n",
    "logprobs = torch.log_softmax(top_logits, dim=0).numpy()\n",
    "\n",
    "print(\"Top-10 tokens y log-probabilidades:\")\n",
    "for t, lp in zip(tokens, logprobs):\n",
    "    print(f\"  {t!r:20s}  logp = {lp:7.4f}  p = {np.exp(lp):.4f}\")\n",
    "\n",
    "fig, axes = plt.subplots(1, 3, figsize=(14, 3.2))\n",
    "for i, temp in enumerate([0.1, 1.0, 2.0]):\n",
    "    scaled = logprobs / temp\n",
    "    scaled -= scaled.max()\n",
    "    probs = np.exp(scaled)\n",
    "    probs /= probs.sum()\n",
    "\n",
    "    axes[i].bar(range(len(tokens)), probs)\n",
    "    axes[i].set_title(f\"Temperatura = {temp}\")\n",
    "    axes[i].set_ylim(0, 1)\n",
    "    axes[i].set_xlabel(\"Token\")\n",
    "    axes[i].set_ylabel(\"Probabilidad\")\n",
    "    axes[i].set_xticks(range(len(tokens)))\n",
    "    axes[i].set_xticklabels(\n",
    "        [t.replace(\"\\n\", \"\\\\n\").replace(\"\\t\", \"\\\\t\") for t in tokens],\n",
    "        rotation=45, ha=\"right\", fontsize=8,\n",
    "    )\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
