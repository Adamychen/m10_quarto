        "print(\"ANTES del re-ranker (orden por embedding):\")\n",
        "for r in resultados[:3]:\n",
        "    print(f\"  [{r['distancia']:.4f}] {r['texto'][:80]}...\")\n",
        "\n",
        "print(\"\\nDESPUÉS del re-ranker (orden por cross-encoder):\")\n",
        "for doc in reranked:\n",
        "    print(f\"  {doc.page_content[:80]}...\")"
