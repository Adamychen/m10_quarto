    "import shutil\n",
    "from pathlib import Path\n",
    "\n",
    "from flashrank import Ranker\n",
    "from langchain_community.document_compressors import FlashrankRerank\n",
    "from langchain_core.documents import Document\n",
    "\n",
    "cache_dir = Path(\"models/flashrank\")\n",
    "model_name = \"ms-marco-TinyBERT-L-2-v2\"\n",
    "model_dir = cache_dir / model_name\n",
    "\n",
    "cache_dir.mkdir(parents=True, exist_ok=True)\n",
    "if model_dir.exists() and not any(model_dir.iterdir()):\n",
    "    shutil.rmtree(model_dir)\n",
    "\n",
    "reranker_client = Ranker(model_name=model_name, cache_dir=str(cache_dir))\n",
    "reranker = FlashrankRerank(client=reranker_client, top_n=3)\n",
    "\n",
    "docs = [Document(page_content=r[\"texto\"], metadata={\"fuente\": r[\"fuente\"]}) for r in resultados]\n",
    "\n",
    "query_test = \"¿Qué productos de electrónica tienen mejor margen?\"\n",
