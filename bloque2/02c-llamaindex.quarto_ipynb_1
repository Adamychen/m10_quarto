        "```{mermaid}\n",
        "graph LR\n",
        "    A[PDF] --> B[Reader<br/>extrae texto]\n",
        "    C[CSV] --> B\n",
        "    D[Web] --> B\n",
        "    B --> E[Transformations<br/>chunking, metadatos]\n",
        "    E --> F[Nodes<br/>unidades indexables]\n",
        "    F --> G[Embeddings<br/>vectoriza]\n",
        "    G --> H[(Vector Store<br/>ChromaDB/FAISS)]\n",
        "\n",
        "    style A fill:#4B8BBE,color:#fff\n",
        "    style F fill:#e65100,color:#fff\n",
        "    style H fill:#FFD43B,color:#000\n",
